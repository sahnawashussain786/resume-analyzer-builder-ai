# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resumeforge?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (free OpenAI-compatible provider, no credit-card required)
# Set AI_PROVIDER=groq to prefer Groq when both keys are present.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI provider selection: openai | groq | (leave blank to auto-pick the first live key)
AI_PROVIDER=

# Set to true to run the app with built-in mock AI (no key needed, for demo purposes)
AI_MOCK=false

[TEMPLATE]
# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resumeforge?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Gemini (RECOMMENDED — free tier from Google AI Studio: https://aistudio.google.com/app/apikey)
# Auto-detected first when this key is present; no force flag needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq (free OpenAI-compatible provider, no credit-card required)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI provider selection: gemini | groq | openai | (leave blank to auto-pick: Gemini -> Groq -> OpenAI)
AI_PROVIDER=

# Set to true to run the app with built-in mock AI (no key needed, for demo purposes)
AI_MOCK=false
